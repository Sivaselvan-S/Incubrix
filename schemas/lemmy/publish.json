{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LemmyPublishResponse",
  "type": "object",
  "required": ["post_view"],
  "properties": {
    "post_view": {
      "type": "object",
      "required": ["post"],
      "properties": {
        "post": {
          "type": "object",
          "required": ["id", "name"],
          "properties": {
            "id": { "type": "integer" },
            "name": { "type": "string" },
            "body": { "type": "string" },
            "ap_id": { "type": "string" },
            "deleted": { "type": "boolean" }
          }
        }
      }
    }
  }
}
