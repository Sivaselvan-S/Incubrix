{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HashnodePublishResponse",
  "type": "object",
  "required": ["data"],
  "properties": {
    "data": {
      "type": "object",
      "required": ["publishPost"],
      "properties": {
        "publishPost": {
          "type": "object",
          "required": ["post"],
          "properties": {
            "post": {
              "type": "object",
              "required": ["id", "url"],
              "properties": {
                "id": { "type": "string" },
                "url": { "type": "string" },
                "title": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
