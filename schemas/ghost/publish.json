{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GhostPublishResponse",
  "type": "object",
  "required": ["posts"],
  "properties": {
    "posts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "url"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "url": { "type": "string" },
          "status": { "type": "string" }
        }
      }
    }
  }
}
