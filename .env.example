# ==============================================================================
# LongTail Passport - Environment Configuration Template
# All secrets and configurable parameters are declared here.
# Copy this file to .env for local overrides (never commit .env).
# ==============================================================================

# Simulation Mode: routes connectors to Chaos Mock Hub. Default for tests & demo.
SIMULATION_MODE=true

# Database Configuration (PostgreSQL 16 in Docker, or sqlite+aiosqlite:///./test.db for local tests)
DATABASE_URL=postgresql+psycopg://incubrix:incubrix_secret@localhost:5432/longtail_passport

# MinIO / S3-compatible Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=passport-evidence
MINIO_SECURE=false

# Chaos Mock Hub URL
MOCKHUB_URL=http://localhost:8010

# Real Local Lemmy Configuration (Docker Compose)
LEMMY_URL=http://localhost:8536
LEMMY_USERNAME=incubrix_admin
LEMMY_PASSWORD=lemmy_local_password_123

# Real Local Ghost Configuration (Docker Compose)
GHOST_URL=http://localhost:2368
GHOST_ADMIN_API_KEY=64f8a7e0c4b6a1234567890a:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# External AI Service Provider Adapter (mock | anthropic | openai)
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Service Runtime Settings
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development

# Worker & Scheduler Settings
WORKER_POLL_INTERVAL_SECONDS=1.0
RECERTIFICATION_INTERVAL_SECONDS=86400
DEMO_RECERTIFICATION_INTERVAL_SECONDS=10
JANITOR_RETENTION_MINUTES=10
